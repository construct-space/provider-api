# provider-api — production env (CapRover sets these on the app).
# Local dev is intentionally out of scope; deploy to a CapRover slot
# and exercise the service against the real `credits` DB.

PORT=80
APP_URL=https://my.lisaos.dev

# CORS — origins allowed to hit the public catalog endpoint.
ALLOWED_ORIGINS=https://my.lisaos.dev,tauri://localhost

# Postgres `credits` DB on the local postgres-db container.
DB_HOST=srv-captain--postgres-db
DB_PORT=5432
DB_NAME=credits
DB_USER=provider_app
DB_PASS=

# Shared with all internal services (accounts, source, oracle, ...).
# Required for the gateway-trust path and for oracle's control-plane
# calls to /api/admin/*.
INTERNAL_SHARED_SECRET=

# Optional. 32-byte base64 key for AES-GCM encryption of Construct's
# upstream API keys at rest. If unset, the encryption key is derived
# from INTERNAL_SHARED_SECRET via SHA-256 — set this only if you want
# encryption to rotate independently of the inter-service auth secret.
# Generate: `openssl rand -base64 32`
CREDITS_UPSTREAM_KEY_SECRET=

# Peers (private-net hostnames inside CapRover swarm).
ORACLE_URL=http://srv-captain--oracle-api

# Added 2026-09-08 from the deployment's keys
R2_ACCOUNT_ID=<account-id>
R2_API_KEY=change-me
R2_API_SECRET=change-me
R2_BUCKET=construct-logs
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://logs.construct.ninja
R2_PREFIX=inference/
R2_UPLOAD_EVERY=1h
